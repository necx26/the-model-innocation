# Example only. No official protocol or model is bundled.
# Run these exports in the terminal before ./competition-start.sh.
export YZBOT_TASK_MODE=official
export YZBOT_OFFICIAL_ADAPTER=official_model_adapter:solve_task
export YZBOT_OFFICIAL_TIMEOUT=45
# Optional JSON configuration path INSIDE the container's workspace mount.
# export YZBOT_OFFICIAL_CONFIG=/home/ros/dev_ws/official-config.json
# For optional development ONLY (compatible llama.cpp endpoint):
# export YZBOT_TASK_MODE=practice
# export YZBOT_PRACTICE_LLM_URL=http://127.0.0.1:8081
