<?xml version="1.0"?>
<robot name="six_arm"
    xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find mybot_description)/urdf/large_base_gazebo.xacro" />
    <xacro:include filename="$(find mybot_description)/urdf/rgbd_gazebo.xacro" />
    <xacro:include filename="$(find mybot_description)/urdf/camera_gazebo.xacro" />
    <xacro:include filename="$(find mybot_description)/urdf/lidar_gazebo.xacro" />
    <xacro:include filename="$(find mybot_description)/urdf/arm_gazebo.xacro" />

    <!-- rgbd - keep model but disable topic publishing -->
    <xacro:property name="rgbd_offset_x" value="0.06" />
    <xacro:property name="rgbd_offset_y" value="0" />
    <xacro:property name="rgbd_offset_z" value="-0.03" />

    <!-- Create RGBD model links and joints (visible in simulation) -->
    <link name="camera_rgbd_link">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <visual>
            <origin xyz="0 0 0" rpy="0 0 ${M_PI/2}" />
            <geometry>
                <box size="0.15 0.04 0.04" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 ${M_PI/2}" />
            <geometry>
                <box size="0.15 0.04 0.04" />
            </geometry>
        </collision>
    </link>

    <joint name="camera_rgbd_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708" />
        <parent link="camera_rgbd_link" />
        <child link="camera_rgbd_frame_optical" />
    </joint>

    <link name="camera_rgbd_frame_optical" />

    <joint name="rgbd_joint" type="fixed">
        <origin xyz="${-rgbd_offset_x} ${rgbd_offset_y} ${rgbd_offset_z}" rpy="0 ${-M_PI/2} 0" />
        <parent link="grasping_frame" />
        <child link="camera_rgbd_link" />
    </joint>

    <!-- Camera -->
    <!-- Keep the lens behind the bumper so a cube 22 cm ahead stays in view. -->
    <xacro:property name="camera_offset_x" value="0.0" />
    <xacro:property name="camera_offset_y" value="0.16" />
    <xacro:property name="camera_offset_z" value="0.30" />

    <!-- Raised camera needs a visible mounting mast, fixed to the original chassis. -->
    <link name="camera_mount_link">
        <inertial>
            <origin xyz="0 0 0.12" />
            <mass value="0.04" />
            <inertia ixx="0.00021" ixy="0" ixz="0" iyy="0.00021" iyz="0" izz="0.000003" />
        </inertial>
        <visual name="camera_mount_foot">
            <origin xyz="-0.025 -0.018 0" />
            <geometry><box size="0.10 0.07 0.012" /></geometry>
            <material name="black" />
        </visual>
        <visual name="camera_mount_mast">
            <origin xyz="0 0 0.115" />
            <geometry><cylinder radius="0.009" length="0.23" /></geometry>
            <material name="black" />
        </visual>
        <collision name="camera_mount_mast_collision">
            <origin xyz="0 0 0.115" />
            <geometry><cylinder radius="0.009" length="0.23" /></geometry>
        </collision>
        <visual name="camera_mount_head">
            <origin xyz="0 0 0.23" />
            <geometry><box size="0.035 0.04 0.025" /></geometry>
            <material name="black" />
        </visual>
    </link>
    <joint name="camera_mount_joint" type="fixed">
        <origin xyz="${camera_offset_x} ${camera_offset_y} ${base_height/2}" />
        <parent link="base_link" />
        <child link="camera_mount_link" />
    </joint>
    <gazebo reference="camera_mount_link"><material>Gazebo/Black</material></gazebo>

    <joint name="camera_joint" type="fixed">
        <!-- Keep both the near grasp point and the next few metres of floor in view. -->
        <origin xyz="${camera_offset_x} ${camera_offset_y} ${camera_offset_z}" rpy="0 0.57 -0.35" />
        <parent link="base_link" />
        <child link="camera_link" />
    </joint>

    <xacro:mipi_camera prefix="camera" />

    <!-- Lidar -->
    <xacro:property name="lidar_offset_x" value="0" />
    <xacro:property name="lidar_offset_y" value="0" />
    <xacro:property name="lidar_offset_z" value="${base_height/2+0.01}" />
    <xacro:property name="robot_radius" value="${(base_length**2 + base_width**2)**0.5 / 2}" />
    <xacro:property name="safety_margin" value="0.05" />

    <joint name="lidar_joint" type="fixed">
        <origin xyz="${lidar_offset_x} ${lidar_offset_y} ${lidar_offset_z}" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="laser_link" />
    </joint>

    <xacro:lidar prefix="laser" gz_visualize="false" range_min="0.25" />
    <!-- <xacro:lidar prefix="laser" gz_visualize="false" range_min="${robot_radius +
    safety_margin}" /> -->

    <!-- arm -->
    <xacro:property name="arm_offset_x" value="0.0" />
    <xacro:property name="arm_offset_y" value="0" />
    <xacro:property name="arm_offset_z" value="${base_height/2+0.01}" />

    <joint name="connect_joint" type="fixed">
        <origin xyz="${arm_offset_x} ${arm_offset_y} ${arm_offset_z}" rpy=" 0 0 0" />
        <parent link="base_link" />
        <child link="arm_base_link" />
    </joint>

</robot>

